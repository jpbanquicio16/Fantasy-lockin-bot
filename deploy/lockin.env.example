# Use the host's own Tailscale IP, never 0.0.0.0.
LOCKIN_BIND_ADDRESS=100.100.100.100
# Mount a second disk/location here. Default local backups do not survive loss of the host.
LOCKIN_BACKUP_DIR=/opt/lockin/data/backups
# Keep notification credentials in this file with mode 0600.
# LOCKIN_ALERT_URLS=["your-apprise-url"]
